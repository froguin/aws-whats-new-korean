---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AWS What's New 한국어 요약">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div id="meta" class="text-sm text-gray-500 dark:text-gray-400 mb-4 hidden">
      <div class="flex justify-between items-center">
        <div id="meta-updated"></div>
        <div id="meta-count"></div>
      </div>
    </div>

    <div class="mb-4">
      <input type="text" id="keyword-search" placeholder="키워드로 검색"
        class="w-full px-3 py-2 border dark:border-gray-600 rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500 placeholder-gray-500 dark:placeholder-gray-400" />
    </div>

    <div id="loading" class="col-span-full text-center py-12">
      <p class="text-gray-500 dark:text-gray-400">업데이트를 불러오는 중...</p>
    </div>

    <div id="error" class="hidden rounded-md bg-red-50 dark:bg-red-900/50 p-4 my-4">
      <div class="ml-3">
        <h3 class="text-sm font-medium text-red-800 dark:text-red-200">오류 발생</h3>
        <p id="error-msg" class="mt-2 text-sm text-red-700 dark:text-red-300"></p>
      </div>
    </div>

    <div id="no-results" class="hidden col-span-full text-center py-12">
      <p class="text-gray-500 dark:text-gray-400">검색 결과가 없습니다.</p>
    </div>

    <div id="cards" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 my-6"></div>
  </div>

  <script is:inline>
    window.__PUBLIC_API_URL__ = window.__PUBLIC_API_URL__ || 'PUBLIC_API_URL_PLACEHOLDER';
  </script>

  <script is:inline>
    const API_URL = window.__PUBLIC_API_URL__ || '';

    function statusClass(status) {
      if (status.includes('미리보기') || status.includes('Preview')) return 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200';
      if (status.includes('베타') || status.includes('Beta')) return 'bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200';
      return 'bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200';
    }

    function renderCard(u) {
      const detail = (icon, label, value) => value ? `
        <div class="flex items-start gap-2">
          <div class="flex-shrink-0 w-4 h-4 mt-0.5 text-[#0972d3] dark:text-[#539fe5]">${icon}</div>
          <div class="flex-1 min-w-0">
            <div class="text-xs font-medium text-[#000716] dark:text-[#ffffff] mb-0.5">${label}</div>
            <div class="text-xs text-[#5f6b7a] dark:text-[#9ba7b6]">${value}</div>
          </div>
        </div>` : '';

      const clockIcon = '<svg viewBox="0 0 16 16" fill="none" class="w-full h-full"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1" fill="none"/><path d="M8 4v4l3 2" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>';
      const checkIcon = '<svg viewBox="0 0 16 16" fill="none" class="w-full h-full"><path d="M13.854 4.146a.5.5 0 010 .708l-7 7a.5.5 0 01-.708 0l-3.5-3.5a.5.5 0 11.708-.708L6.5 10.793l6.646-6.647a.5.5 0 01.708 0z" fill="currentColor"/></svg>';
      const globeIcon = '<svg viewBox="0 0 16 16" fill="none" class="w-full h-full"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1" fill="none"/><circle cx="8" cy="8" r="2" fill="currentColor"/></svg>';

      let status = u.status || '정식 출시';
      try { const s = JSON.parse(status); if (Array.isArray(s)) status = s.join(', '); } catch {}

      return `<div class="update-card"><article class="group bg-white dark:bg-[#0f1b2a] rounded-lg border border-[#e9ebed] dark:border-[#414d5c] hover:border-[#0972d3] dark:hover:border-[#539fe5] transition-all duration-200 overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1">
        <div class="p-5">
          <div class="flex items-center gap-2 mb-2">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${statusClass(status)}">${status}</span>
            <time class="text-xs text-[#5f6b7a] dark:text-[#9ba7b6]">${u.date}</time>
          </div>
          <h3 class="text-base font-bold text-[#000716] dark:text-[#ffffff] mb-2 line-clamp-2 leading-snug">${u.title}</h3>
          <p class="text-sm text-[#5f6b7a] dark:text-[#9ba7b6] mb-4 line-clamp-3 group-hover:line-clamp-none leading-relaxed transition-all duration-200">${u.content}</p>
          <div class="space-y-2.5 pt-3 border-t border-[#e9ebed] dark:border-[#414d5c]">
            ${detail(clockIcon, '대상', u.target)}
            ${detail(checkIcon, '주요 기능', u.features)}
            ${detail(globeIcon, '지원 리전', u.regions)}
          </div>
        </div>
        ${u.originalLink ? `<div class="px-5 py-3 bg-[#fafafa] dark:bg-[#16232e] border-t border-[#e9ebed] dark:border-[#414d5c] group-hover:bg-[#0972d3]/10 dark:group-hover:bg-[#0972d3]/20 transition-colors duration-200"><a href="${u.originalLink}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm font-medium text-[#0972d3] dark:text-[#539fe5] hover:underline">자세히 보기 <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div>` : ''}
      </article></div>`;
    }

    async function loadArticles() {
      const loading = document.getElementById('loading');
      const errorEl = document.getElementById('error');
      const cards = document.getElementById('cards');
      const metaEl = document.getElementById('meta');

      if (!API_URL) { loading.innerHTML = '<p class="text-gray-500">API URL이 설정되지 않았습니다.</p>'; return; }

      try {
        const resp = await fetch(API_URL + '/articles?lang=ko&limit=50');
        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        const data = await resp.json();
        loading.classList.add('hidden');

        if (data.items && data.items.length > 0) {
          metaEl.classList.remove('hidden');
          document.getElementById('meta-count').textContent = '총 ' + data.count + '개의 업데이트';
          document.getElementById('meta-updated').textContent = '마지막 업데이트: ' + new Date().toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' });

          cards.innerHTML = data.items.map(item => renderCard({
            title: item.title,
            date: item.pubDate ? new Date(item.pubDate).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' }) : '',
            content: item.summary || item.description || '',
            target: item.target, features: item.features, regions: item.regions,
            status: item.status, originalLink: item.url,
          })).join('');
        } else {
          cards.innerHTML = '<div class="col-span-full text-center py-12"><p class="text-gray-500 dark:text-gray-400">현재 표시할 업데이트가 없습니다.</p></div>';
        }
      } catch (e) {
        loading.classList.add('hidden');
        errorEl.classList.remove('hidden');
        document.getElementById('error-msg').textContent = '데이터를 불러오는 중 오류가 발생했습니다: ' + e.message;
      }
    }

    // Search filter
    document.getElementById('keyword-search').addEventListener('input', function() {
      const q = this.value.toLowerCase().trim();
      const items = document.querySelectorAll('.update-card');
      let visible = 0;
      items.forEach(c => { const show = !q || c.textContent.toLowerCase().includes(q); c.style.display = show ? '' : 'none'; if (show) visible++; });
      document.getElementById('no-results').classList.toggle('hidden', visible > 0);
      document.getElementById('cards').classList.toggle('hidden', visible === 0);
    });

    loadArticles();
  </script>

  <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-6K10Z2P301"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-6K10Z2P301');
  </script>
</Layout>
