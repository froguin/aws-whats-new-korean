# AWS SAM deployment
AWS_REGION=ap-northeast-2

# Bedrock models (cross-region inference)
BEDROCK_TRANSLATE_MODEL=apac.amazon.nova-micro-v1:0
BEDROCK_REVIEW_MODEL=apac.amazon.nova-lite-v1:0

# Netlify (for data migration only)
NETLIFY_SITE_ID=
NETLIFY_ACCESS_TOKEN=

# DynamoDB table name (auto-set by SAM)
TABLE_NAME=aws-whats-new-prod
