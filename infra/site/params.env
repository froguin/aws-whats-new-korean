# whats-new.awskr.net -- AWS 새로운 소식 한국어 요약 (frontend static SPA on S3 + CloudFront FREE plan).
# whats-new.awskr.net is the PRIMARY (canonical) host; whatsnew.awskr.net is a second alias on the
# same distribution. The old host release.awskr.net is handled off-AWS by a Netlify redirect site
# (netlify-production branch) that 301s release -> whats-new.
# The standalone backend (infra/backend/, stack awskr-backend-whatsnew) serves the API.
StackName=awskr-site-aws-whats-new-korean
SiteName=aws-whats-new-korean
DomainName=whats-new.awskr.net
ExtraDomainName=whatsnew.awskr.net
AttachAlias=true
ManageDnsRecords=false
CreateBucket=true
BucketName=awskr-whats-new-korean-site
UrlMode=spa
GitHubSubject=repo:froguin/aws-whats-new-korean:ref:refs/heads/main
