# whatsnew.awskr.net -- AWS What's New 한국어 요약 (frontend static SPA on S3 + CloudFront FREE plan).
# The old host release.awskr.net stays as a second alias on the SAME distribution and the
# CloudFront viewer-request function 301-redirects it to whatsnew.awskr.net (SEO preserved).
# The standalone backend (infra/backend/, stack awskr-backend-whatsnew) serves the API.
StackName=awskr-site-aws-whats-new-korean
SiteName=aws-whats-new-korean
DomainName=whatsnew.awskr.net
ExtraDomainName=release.awskr.net
AttachAlias=true
ManageDnsRecords=false
CreateBucket=true
BucketName=awskr-whats-new-korean-site
UrlMode=spa
GitHubSubject=repo:froguin/aws-whats-new-korean:ref:refs/heads/main
